                    CELLSPACING="0" CELLPADDING="4">
                    <TR>
                        <TD ROWSPAN="2">Period encoder<BR/>Masked mean over valid episodes<BR/>MLP 256 → 256 → 256</TD>
                        <TD COLSPAN="2">input:</TD>
                        <TD COLSPAN="2">(1, 5, 256), (1, 5), (1, 5, 40) </TD>
                    </TR>
                    <TR>
                        <TD COLSPAN="2">output: </TD>
                        <TD COLSPAN="2">(1, 256) </TD>
                    </TR>
                    </TABLE>> fillcolor=darkseagreen1]
	8 [label=<
                    <TABLE BORDER="0" CELLBORDER="1"
                    CELLSPACING="0" CELLPADDING="4">
                    <TR>
                        <TD ROWSPAN="2">Actor<BR/>Concat → MLP 409 → 256 → 256<BR/>6 actions + log-softmax</TD>
                        <TD COLSPAN="2">input:</TD>
                        <TD COLSPAN="2">(1, 153), (1, 256) </TD>
                    </TR>
                    <TR>
                        <TD COLSPAN="2">output: </TD>
                        <TD COLSPAN="2">(1, 6) </TD>
